{
  "id": "en",
  "version": "en-1.0",
  "negation": {
    "cues": ["never", "not", "no", "don't", "dont", "won't", "wont", "wouldn't", "wouldnt", "nor"],
    "before": 4,
    "after": 0
  },
  "clauseBreaks": ["but", "and", "so", "though", "although", "however", "because", "or"],
  "rules": [
    {
      "id": "EN-SI-INTENT-1",
      "label": "States a plan or intent to end their life",
      "dimension": "SUICIDAL_IDEATION",
      "score": 0.95,
      "confidence": 0.85,
      "flags": ["SUICIDAL_INTENT"],
      "patterns": [
        "(?:going|planning|plan|decided|about) to (?:kill myself|end (?:my|this) life|take my (?:own )?life|end it(?: all)?|commit suicide)",
        "(?:will|i['’]ll|gonna) (?:kill myself|end (?:my|this) life|take my (?:own )?life|commit suicide)",
        "(?:kill|killing) myself (?:tonight|today|now|right now)",
        "(?:bought|got|have|kept|saved|collected) (?:the |some )?(?:poison|pills|tablets|rope) to (?:die|end (?:it|my life)|kill myself)",
        "(?:wrote|written|writing|left) (?:a |my )?(?:suicide|goodbye) (?:note|letter)"
      ]
    },
    {
      "id": "EN-SI-EXPLICIT-1",
      "label": "Says they want to die or end their life",
      "dimension": "SUICIDAL_IDEATION",
      "score": 0.9,
      "confidence": 0.8,
      "flags": ["PASSIVE_SUICIDAL_IDEATION"],
      "patterns": [
        "(?:want|wanna|wish|wishing) to (?:die|kill myself|end (?:my|this) life|end it all|commit suicide|be dead)",
        "(?:thinking|thought|thoughts|think) (?:of|about) (?:suicide|killing myself|ending (?:my|this) life|ending it(?: all)?|dying)",
        "(?:wish|wished) (?:i was|i were|i had) (?:dead|never been born)",
        "better off dead"
      ]
    },
    {
      "id": "EN-SI-INDIRECT-1",
      "label": "Indirect wish to be dead (no point living, better without me)",
      "dimension": "SUICIDAL_IDEATION",
      "score": 0.75,
      "confidence": 0.7,
      "flags": ["PASSIVE_SUICIDAL_IDEATION"],
      "patterns": [
        "no (?:point|reason|use) (?:in living|to live|living|in going on|anymore|any more)",
        "(?:my )?(?:family|everyone|they|children|kids) (?:would|will) be (?:better|happier) (?:off )?without me",
        "do(?:n['’]?t| not) want to (?:live|be alive|wake up)",
        "tired of (?:living|life|being alive)"
      ]
    },
    {
      "id": "EN-SI-MENTION-1",
      "label": "Mentions suicide",
      "dimension": "SUICIDAL_IDEATION",
      "score": 0.7,
      "confidence": 0.55,
      "flags": ["PASSIVE_SUICIDAL_IDEATION"],
      "patterns": ["suicid(?:e|al)"]
    },
    {
      "id": "EN-SELFHARM-1",
      "label": "Mentions harming themselves",
      "dimension": "SUICIDAL_IDEATION",
      "score": 0.8,
      "confidence": 0.7,
      "flags": ["PASSIVE_SUICIDAL_IDEATION"],
      "patterns": ["(?:hurt|harm|harming|hurting|cut|cutting) myself", "self[- ]harm"]
    },
    {
      "id": "EN-HOPELESS-1",
      "label": "Cannot go on",
      "dimension": "SUICIDAL_IDEATION",
      "score": 0.6,
      "confidence": 0.6,
      "patterns": ["(?:can['’]?t|cannot) (?:go on|take (?:it|this) any ?more|live like this|bear (?:it|this) any ?more)"]
    },
    {
      "id": "EN-DANGER-PRESENT-1",
      "label": "Accused is outside or nearby now",
      "dimension": "INTIMIDATION",
      "score": 0.95,
      "confidence": 0.8,
      "flags": ["ACCUSED_PRESENT"],
      "patterns": [
        "(?:they|he|the accused|those (?:people|men)|they['’]re|he['’]s) (?:are |is )?(?:standing |waiting |sitting )?(?:outside|in front of|at) (?:my|our|the) (?:house|home|door|gate)",
        "(?:standing|waiting|sitting) outside (?:my|our|the) (?:house|home|door|gate)",
        "(?:they|he|the accused)(?:['’]re|['’]s| are| is) (?:here|outside) (?:now|right now)",
        "(?:coming|on their way) (?:here|to (?:my|our) (?:house|home)) (?:now|right now)"
      ]
    },
    {
      "id": "EN-DANGER-CONFINED-1",
      "label": "Locked in or not allowed to leave",
      "dimension": "INTIMIDATION",
      "score": 0.9,
      "confidence": 0.8,
      "flags": ["CONFINED"],
      "patterns": [
        "locked (?:me |us )?(?:in|inside|up)",
        "(?:not|won['’]?t|will not) (?:let|letting) (?:me|us) (?:leave|go out|out|go)",
        "(?:trapped|held|kept) (?:in|inside) (?:a |the |this )?(?:room|house)"
      ]
    },
    {
      "id": "EN-DANGER-INJURY-1",
      "label": "Current injury needing urgent care",
      "dimension": "SEVERE_TRAUMA",
      "score": 0.85,
      "confidence": 0.75,
      "flags": ["SERIOUS_INJURY"],
      "patterns": [
        "(?:i am|i['’]m|she is|he is|they are) (?:badly |still )?(?:bleeding|injured|hurt badly)",
        "(?:broken|fractured) (?:arm|leg|bone|hand|ribs?)",
        "need (?:a |an )?(?:doctor|hospital|ambulance) (?:now|urgently|right now)"
      ]
    },
    {
      "id": "EN-THREAT-LIFE-1",
      "label": "Threat to kill the person or family",
      "dimension": "INTIMIDATION",
      "score": 0.9,
      "confidence": 0.8,
      "flags": ["THREAT_TO_LIFE"],
      "patterns": [
        "(?:threaten(?:ed|ing|s)?|said (?:they|he) (?:will|would)|will) (?:to )?kill (?:me|us|my (?:family|son|daughter|husband|wife|father|mother|children|brother|sister))",
        "kill (?:me|us|my family) if",
        "threats? to (?:my|our) li(?:fe|ves)"
      ]
    },
    {
      "id": "EN-THREAT-1",
      "label": "Threats or warnings",
      "dimension": "INTIMIDATION",
      "score": 0.75,
      "confidence": 0.7,
      "patterns": ["threat(?:en|ened|ening|ens|s)?", "(?:warned|warning) (?:me|us)"]
    },
    {
      "id": "EN-PRESSURE-1",
      "label": "Pressure to withdraw the complaint or change statement",
      "dimension": "INTIMIDATION",
      "score": 0.85,
      "confidence": 0.8,
      "flags": ["PRESSURE_TO_WITHDRAW"],
      "patterns": [
        "withdraw (?:the|my|our) (?:case|complaint|fir)",
        "take back (?:the|my|our) (?:case|complaint|fir)",
        "(?:drop|settle) (?:the|my|our) case",
        "(?:change|turn) (?:my|our|the) (?:statement|testimony)",
        "compromise (?:with them|in the case)"
      ]
    },
    {
      "id": "EN-ISOLATION-BOYCOTT-1",
      "label": "Social boycott",
      "dimension": "SOCIAL_ISOLATION",
      "score": 0.8,
      "confidence": 0.75,
      "patterns": ["(?:social(?:ly)? )?boycott(?:ed)?", "not allowed to (?:take|use|draw|fetch) water"]
    },
    {
      "id": "EN-ISOLATION-DISPLACED-1",
      "label": "Forced out of home or village",
      "dimension": "SOCIAL_ISOLATION",
      "score": 0.85,
      "confidence": 0.75,
      "flags": ["DISPLACED"],
      "patterns": ["(?:thrown|forced|driven|chased) out of (?:the |our |my )?(?:village|house|home|community)"]
    },
    {
      "id": "EN-ISOLATION-ALONE-1",
      "label": "Nobody to turn to",
      "dimension": "SOCIAL_ISOLATION",
      "score": 0.7,
      "confidence": 0.65,
      "patterns": [
        "no ?one (?:to|will|who will) (?:help|talk to|turn to|support)",
        "(?:nobody|no one) (?:talks|speaks|helps) (?:to )?(?:me|us)",
        "cut off (?:from|by) (?:my |our )?(?:family|community|village)",
        "(?:all )?alone (?:now|here|in this)"
      ]
    },
    {
      "id": "EN-FACT-NOT-REGISTERED-1",
      "label": "Complaint not registered",
      "fact": "COMPLAINT_NOT_REGISTERED",
      "patterns": [
        "(?:police|they) (?:refused|did not|didn['’]?t|won['’]?t|would not) (?:to )?(?:register|file|write|take) (?:my |the |our )?(?:complaint|fir|case)",
        "fir (?:was |is )?(?:not|never) (?:registered|filed|written)"
      ]
    },
    {
      "id": "EN-FACT-RIGHTS-1",
      "label": "Unsure of rights or what to do",
      "fact": "RIGHTS_CONFUSION",
      "patterns": ["do(?:n['’]?t| not) know (?:my rights|what to do|where to go|who to ask)"]
    },
    {
      "id": "EN-FACT-LONG-CASE-1",
      "label": "Long-running case",
      "fact": "LONG_RUNNING_CASE",
      "patterns": ["case (?:has been|is) (?:going on|pending|running|dragging) for (?:years|\\d+ years|many (?:months|years))"]
    },
    {
      "id": "EN-FACT-WITNESS-1",
      "label": "Witness under threat",
      "fact": "WITNESS_UNDER_THREAT",
      "patterns": ["witness(?:es)? (?:is|are|was|were|being) (?:threatened|beaten|pressured|scared)"]
    }
  ]
}
