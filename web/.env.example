# Copy to .env.local and fill in. Never commit .env.local (CLAUDE.md).
# All services are free tiers: see docs/TOOLS_AND_COSTS.md.

# --- MongoDB Atlas (replica set). Two databases: nhaa_assess and nhaa_pii (NFR-PRI-03)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_PII_URI=mongodb+srv://<pii-user>:<password>@<cluster>/?retryWrites=true&w=majority

# --- Field encryption (AES-256-GCM). JSON map of key id -> base64 32-byte key.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS={"k1":"<base64-32-bytes>"}
ENCRYPTION_ACTIVE_KEY=k1

# --- Auth.js (staff login). Generate: npx auth secret  (or 32+ random bytes, base64)
AUTH_SECRET=<random-secret>

# --- Analysis service (Python FastAPI). Local: http://localhost:8000 ; demo: Cloudflare tunnel URL
ANALYSIS_URL=http://localhost:8000
ANALYSIS_HMAC_SECRET=<random-secret-shared-with-analysis-service>

# --- Real time. REALTIME_DRIVER=pusher (default) or sse (local only; Pusher keys then optional)
REALTIME_DRIVER=pusher
PUSHER_APP_ID=<app-id>
PUSHER_KEY=<key>
PUSHER_SECRET=<secret>
PUSHER_CLUSTER=ap2

# --- Protects POST /api/v1/internal/jobs/run
JOBS_SECRET=<random-secret>

# Demo input layer (PRODUCT_VISION.md §6, tasks M.11 and M.14). Off by default; the module never needs it.
# `npm run api:client -- --demo` creates the demo key and writes DEMO_API_KEY into .env.local.
# Its scopes must include status:read and questions:read (Phase P). An older demo client: `npm run api:client -- --update-demo-scopes`.
DEMO_ENABLED=false
DEMO_API_KEY=
